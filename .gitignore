# Extracted SDKs and toolchains populated by
# ch01-simulator-setup/install_tools.sh (very large; never commit these).
/tools/*
/downloads/*

# Build outputs from the scalar and intrinsic labs.
# Both scripts/run_*.sh and scripts/gen_*.sh write here, producing
# Hexagon ELF binaries, host gcc binaries, and benchmark probes.
build/
**/build/

# Compiled host/Hexagon test binary from ch01-simulator-setup/test_hvx_hmx.c
# (the .c source is fine to track, the build output is not).

# Common host / cross-compilation artefacts.
*.o
*.obj
*.elf
*.exe
*.so
*.a
*.dylib
*.dSYM/
*.gch
*.pch
*.d

# Editor / OS noise.
*~
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent / harness state (worktrees, session files).
.claude/
.agents/
.codex/

# Ad-hoc local probe scripts and logs that don't belong in history.
tmp_*.sh
tmp_*.log

# Windows alternate-data-stream metadata copied from NTFS.
*:Zone.Identifier

# Device/qprof measurement output. Keep curated summaries in README_result_*.md,
# not multi-GB raw profiler captures.
results/qprof/
qprof_*_runs/
qprof_*_runs*/
qprof_hqc_*_runs/

# Generated deployment artifact snapshots.
hqc_fastrpc_intrinsic_android/
**/android_artifacts/
**/*_artifacts/

# Local credentials and scratch notes.
qdc_id_*.pem
secrets/
lenh.txt

# Generated reports / PDFs unless intentionally promoted.
*.aux
*.log
*.out
*.pdf
*-metrics.json
